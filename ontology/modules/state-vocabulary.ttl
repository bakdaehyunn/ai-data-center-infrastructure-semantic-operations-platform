@prefix dcai: <urn:dcai:ontology:> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix criticality: <urn:dcai:state:criticality:> .
@prefix operational: <urn:dcai:state:operational-status:> .
@prefix lifecycle: <urn:dcai:state:incident-lifecycle:> .
@prefix dependencyRole: <urn:dcai:state:dependency-role:> .
@prefix impactScope: <urn:dcai:state:impact-scope:> .
@prefix workflowStatus: <urn:dcai:state:workflow-event-status:> .
@prefix redundancy: <urn:dcai:state:redundancy-state:> .
@prefix mitigation: <urn:dcai:state:mitigation-state:> .
@prefix vendor: <urn:dcai:state:vendor-state:> .
@prefix confidence: <urn:dcai:state:evidence-confidence:> .
@prefix telemetry: <urn:dcai:state:telemetry-status:> .
@prefix validation: <urn:dcai:state:validation-status:> .
@prefix workOrder: <urn:dcai:state:work-order-status:> .

dcai:state-vocabulary
  rdf:type owl:Ontology ;
  dcterms:title "DCAI controlled state vocabulary module" ;
  dcterms:description "Authoritative closed vocabularies for canonical infrastructure, topology, workflow, impact, and evidence state concepts. Canonical codes use lowercase kebab-case; source-system spelling is normalized during promotion." ;
  owl:imports dcai:core, dcai:infrastructure, dcai:topology, dcai:workflow, dcai:impact, dcai:evidence ;
  owl:versionInfo "2026-09-state-semantics-hardening-v1" .

dcai:CriticalityLevel owl:equivalentClass [ rdf:type owl:Class ; owl:oneOf ( criticality:critical criticality:high ) ] .
dcai:OperationalStatus owl:equivalentClass [ rdf:type owl:Class ; owl:oneOf (
  operational:alerting operational:at-risk operational:degraded operational:gap
  operational:monitor operational:recovering operational:running operational:stable
) ] .
dcai:IncidentLifecycleState owl:equivalentClass [ rdf:type owl:Class ; owl:oneOf ( lifecycle:in-progress lifecycle:restored ) ] .
dcai:DependencyRole owl:equivalentClass [ rdf:type owl:Class ; owl:oneOf (
  dependencyRole:cooling-loop dependencyRole:cooling-supply dependencyRole:power-feed
  dependencyRole:power-supply dependencyRole:telemetry-source dependencyRole:upstream-gpu-fabric
) ] .
dcai:ImpactScope owl:equivalentClass [ rdf:type owl:Class ; owl:oneOf (
  impactScope:downstream-rack-row impactScope:gpu-pod impactScope:pod
  impactScope:rack-group impactScope:rack-row impactScope:row
) ] .
dcai:WorkflowEventStatus owl:equivalentClass [ rdf:type owl:Class ; owl:oneOf (
  workflowStatus:active workflowStatus:blocked workflowStatus:complete
  workflowStatus:completed workflowStatus:delayed workflowStatus:open workflowStatus:ready
) ] .
dcai:RedundancyState owl:equivalentClass [ rdf:type owl:Class ; owl:oneOf (
  redundancy:n-1 redundancy:n-plus-0 redundancy:n-plus-1 redundancy:nominal
) ] .
dcai:MitigationState owl:equivalentClass [ rdf:type owl:Class ; owl:oneOf (
  mitigation:awaiting-signoff mitigation:capacity-buffer-reduced mitigation:capacity-watch
  mitigation:dispatch-pending mitigation:evidence-review mitigation:fan-curve-adjusted
  mitigation:load-shed-active mitigation:manual-mitigation-active mitigation:manual-sampling-active
  mitigation:mitigated mitigation:not-started mitigation:pending-verification mitigation:restore-blocked
  mitigation:running-degraded mitigation:telemetry-replay-pending mitigation:thermal-throttle-active
  mitigation:validation-hold mitigation:workload-evacuation-active
) ] .
dcai:VendorState owl:equivalentClass [ rdf:type owl:Class ; owl:oneOf (
  vendor:eta-met vendor:eta-missed vendor:eta-pending vendor:monitoring vendor:parts-review vendor:vendor-engaged
) ] .
dcai:EvidenceConfidenceState owl:equivalentClass [ rdf:type owl:Class ; owl:oneOf (
  confidence:conflicted confidence:low-confidence confidence:review confidence:review-required confidence:trusted
) ] .
dcai:TelemetryStatus owl:equivalentClass [ rdf:type owl:Class ; owl:oneOf (
  telemetry:alerting telemetry:conflict telemetry:critical telemetry:degraded telemetry:gap
  telemetry:missing-gap telemetry:normal telemetry:recovering telemetry:warning
) ] .
dcai:ValidationStatus owl:equivalentClass [ rdf:type owl:Class ; owl:oneOf (
  validation:awaiting-temperature-stabilization validation:awaiting-transfer-test
  validation:blast-radius-review-required validation:blocked validation:conflicting
  validation:cooling-loop-confirmed validation:failed validation:field-dispatch-needed
  validation:manual-confirmation-required validation:missing-final-validation validation:passed
  validation:power-path-confirmed validation:primary-validation-pass validation:recovery-blocked-by-telemetry
  validation:repair-window-delayed validation:repeat-failure-observed validation:restore-readiness-blocked
  validation:secondary-validation-conflict validation:telemetry-gap-detected
) ] .
dcai:WorkOrderStatus owl:equivalentClass [ rdf:type owl:Class ; owl:oneOf (
  workOrder:assigned workOrder:awaiting-assignment workOrder:awaiting-signoff workOrder:blocked
  workOrder:capacity-review workOrder:completed workOrder:conflict-review workOrder:delayed
  workOrder:dispatched workOrder:in-progress workOrder:manual-review workOrder:pending-verification
  workOrder:requested workOrder:waiting-spare-vendor workOrder:waiting-vendor
) ] .

criticality:critical rdf:type dcai:CriticalityLevel ; dcai:hasIdentifier "critical" ; rdfs:label "critical" .
criticality:high rdf:type dcai:CriticalityLevel ; dcai:hasIdentifier "high" ; rdfs:label "high" .

operational:alerting rdf:type dcai:OperationalStatus ; dcai:hasIdentifier "alerting" ; rdfs:label "alerting" .
operational:at-risk rdf:type dcai:OperationalStatus ; dcai:hasIdentifier "at-risk" ; rdfs:label "at-risk" .
operational:degraded rdf:type dcai:OperationalStatus ; dcai:hasIdentifier "degraded" ; rdfs:label "degraded" .
