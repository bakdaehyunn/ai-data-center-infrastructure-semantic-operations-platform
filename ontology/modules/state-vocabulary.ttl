operational:stable rdf:type dcai:OperationalStatus ; dcai:hasIdentifier "stable" ; rdfs:label "stable" .

lifecycle:in-progress rdf:type dcai:IncidentLifecycleState ; dcai:hasIdentifier "in-progress" ; rdfs:label "in-progress" .
lifecycle:restored rdf:type dcai:IncidentLifecycleState ; dcai:hasIdentifier "restored" ; rdfs:label "restored" .

