dcai-release:2026-09-state-semantics-hardening-v1
  rdf:type owl:Ontology ;
  dcterms:title "State semantics hardening v1 release" ;
  dcterms:description "Local ontology contract hardening that separates workflow stage from incident lifecycle state, deprecates the duplicate incident-stage-state vocabulary, closes every canonical controlled vocabulary with OWL enumerations and matching SHACL allow-lists, declares categories disjoint, normalizes source spellings to canonical lowercase kebab-case, makes single-valued state properties functional, and validates literal-to-concept consistency. Existing recorded incident files remain readable because lifecycleState is optional at ingestion; when supplied it is independently mapped and restricted to in-progress or restored. This release does not expose endpoints, mutate deployed graphs, commit, push, or publish." ;
  dcterms:created "2026-09-06"^^xsd:date ;
  dcterms:requires dcai-release:2026-06-ai-data-center-operations-ontology-hardening-v1 ;
