@prefix dcai: <urn:dcai:ontology:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcai:ImpactObservationShape
  a sh:NodeShape ;
  sh:targetClass dcai:ImpactObservation ;
  sh:property [
    sh:path dcai:impactForIncident ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class dcai:InfrastructureIncident
  ] ;
  sh:property [
    sh:path dcai:estimatedCapacityRiskKw ;
    sh:minCount 0 ;
    sh:datatype xsd:decimal
  ] ;
  sh:property [
    sh:path dcai:affectedGpuCount ;
    sh:minCount 0 ;
    sh:datatype xsd:integer
  ] ;
  sh:property [
    sh:path dcai:hasRedundancyState ;
    sh:maxCount 1 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path dcai:hasRedundancyStateConcept ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:class dcai:RedundancyState
  ] ;
  sh:property [
    sh:path dcai:hasMitigationState ;
    sh:maxCount 1 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path dcai:hasMitigationStateConcept ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:class dcai:MitigationState
  ] ;
  sh:property [
    sh:path dcai:hasVendorState ;
    sh:maxCount 1 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path dcai:hasVendorStateConcept ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:class dcai:VendorState
  ] ;
  sh:property [
    sh:path ( dcai:hasRedundancyStateConcept rdfs:label ) ;
    sh:equals dcai:hasRedundancyState ;
    sh:message "Redundancy status literal and controlled state must occur together and have the same label."
  ] ;
  sh:property [
    sh:path ( dcai:hasMitigationStateConcept rdfs:label ) ;
    sh:equals dcai:hasMitigationState ;
    sh:message "Mitigation status literal and controlled state must occur together and have the same label."
  ] ;
  sh:property [
    sh:path ( dcai:hasVendorStateConcept rdfs:label ) ;
    sh:equals dcai:hasVendorState ;
    sh:message "Vendor status literal and controlled state must occur together and have the same label."
  ] .

dcai:EvidenceSupportShape
  a sh:NodeShape ;
  sh:targetClass dcai:EvidenceRecord ;
  sh:or (
    [ sh:property [ sh:path dcai:supportsFact ; sh:minCount 1 ] ]
    [ sh:property [ sh:path dcai:contradictsFact ; sh:minCount 1 ] ]
  ) ;
  sh:property [
    sh:path dcai:hasConfidenceState ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path dcai:hasEvidenceConfidence ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class dcai:EvidenceConfidenceState
  ] ;
  sh:property [
    sh:path dcai:hasEvidenceTimestamp ;
    sh:minCount 1 ;
    sh:datatype xsd:dateTime
  ] ;
  sh:property [
    sh:path ( dcai:hasEvidenceConfidence rdfs:label ) ;
    sh:equals dcai:hasConfidenceState ;
    sh:message "hasConfidenceState must equal the rdfs:label of hasEvidenceConfidence."
  ] .

dcai:TelemetryEvidenceShape
  a sh:NodeShape ;
  sh:targetClass dcai:TelemetryEvidence ;
  sh:property [
    sh:path dcai:hasTelemetryAlertId ;
    sh:minCount 0 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path dcai:hasAlertType ;
    sh:minCount 0 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path dcai:hasAlertSeverity ;
    sh:minCount 0 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path dcai:alertTriggeredAt ;
    sh:minCount 0 ;
    sh:datatype xsd:dateTime
  ] ;
  sh:property [
    sh:path dcai:alertResolvedAt ;
    sh:minCount 0 ;
    sh:datatype xsd:dateTime
  ] ;
  sh:property [
    sh:path dcai:hasTelemetryStatus ;
    sh:maxCount 1 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path dcai:hasTelemetryState ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:class dcai:TelemetryStatus
  ] ;
  sh:property [
    sh:path ( dcai:hasTelemetryState rdfs:label ) ;
    sh:equals dcai:hasTelemetryStatus ;
    sh:message "Telemetry status literal and controlled state must occur together and have the same label."
  ] .

dcai:ValidationEvidenceShape
  a sh:NodeShape ;
  sh:targetClass dcai:ValidationEvidence ;
  sh:property [
    sh:path dcai:hasValidationId ;
    sh:minCount 1 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path dcai:hasValidationStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path dcai:hasValidationState ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class dcai:ValidationStatus
  ] ;
  sh:property [
    sh:path ( dcai:hasValidationState rdfs:label ) ;
    sh:equals dcai:hasValidationStatus ;
    sh:message "hasValidationStatus must equal the rdfs:label of hasValidationState."
  ] .

dcai:WorkOrderEvidenceShape
  a sh:NodeShape ;
  sh:targetClass dcai:WorkOrderEvidence ;
  sh:property [
    sh:path dcai:hasWorkOrderId ;
    sh:minCount 1 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path dcai:hasWorkOrderStatus ;
    sh:maxCount 1 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path dcai:hasWorkOrderState ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:class dcai:WorkOrderStatus
  ] ;
  sh:property [
    sh:path ( dcai:hasWorkOrderState rdfs:label ) ;
    sh:equals dcai:hasWorkOrderStatus ;
    sh:message "Work-order status literal and controlled state must occur together and have the same label."
  ] .
